# =============================================================================
# MYTHOS environment template. Copy to `.env.local` (frontend) / set in your shell
# (server). Nothing here is required for local play - defaults just work.
# =============================================================================

# ---- Frontend (Vite). Everything prefixed VITE_ is bundled into the browser, so
# ---- it must NEVER contain secrets.
# Which backend adapter to use. Only `local` is implemented today.
VITE_BACKEND=local
# Base URL of the MYTHOS API. Leave empty to use the same origin (Vite dev proxy,
# or the Node server serving the built app). Set it when the frontend is hosted
# separately, e.g. VITE_API_URL=https://mythos-api.example.com
VITE_API_URL=

# Future cloud path (Supabase). Public values from Supabase Dashboard ->
# Project Settings -> API. The anon key is public by design (RLS protects data).
# VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ---- Local server (Node). Server-only: never prefix these with VITE_.
# PORT=3001
# MYTHOS_HOST=0.0.0.0
# Where the PGlite database + session secret are stored (default: ./.data)
# MYTHOS_DATA_DIR=./.data
# Signing secret for session tokens (>= 32 chars). If unset, a random one is
# generated and stored in MYTHOS_DATA_DIR/session.secret.
# MYTHOS_SESSION_SECRET=
# Minimum connected players required to start a battle (1 allows solo practice)
# MYTHOS_MIN_PLAYERS=1
# Extra allowed CORS origins, comma separated (only needed with VITE_API_URL)
# MYTHOS_CORS_ORIGINS=

# ---- Supabase server-only secrets (future): set with `supabase secrets set`,
# ---- never in this file or in Vercel frontend variables.
# SUPABASE_SERVICE_ROLE_KEY=   (automatically available inside Edge Functions)
